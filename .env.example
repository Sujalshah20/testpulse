# ============================================
# OEPP Environment Configuration Template
# ============================================
# Copy this file to .env and fill in your actual values
# Never commit the .env file to version control

# ============================================
# DATABASE (Supabase PostgreSQL)
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# REDIS (Upstash)
# ============================================
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token-here

# ============================================
# JWT Authentication
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-min-32-chars-here-generate-random
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-here-generate-random
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# Server Configuration
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# Frontend URL (for CORS)
# ============================================
CLIENT_URL=http://localhost:5173

# ============================================
# Render Deployment (Optional)
# ============================================
# Keep these commented for local development
# Uncomment when deploying to Render
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
